#connect to repository
#Case1. if you already have a repository on github.
# clone your repository ssh code by clicking code -> SSH -> Two overlapping small squares. now, you copu URL to your clipboard. back to git bash.
code:
git clone "your clipboard"
cd "repository name"

#Case2. you already have your project in your computer
code:
cd "your project directory"                                               ### locate your project
git init                                                                  ### initiate your project to be a git repository directory/file
touch README.md                                                           ### if there is no README.md file, create one;else, update the revies time of README.md file.
git add README.md                                                         ###create a history point to this 
git commit -m "add README"                                                ###repository. it means that every steps you do in future will be recorded at this point. and commit it with commit note.
git remote add origin git@github.com:"username"/"repository name".git     ###connect to remote repository
git branch -M main                                                        ###force rename current branch name as main, and set it as current branch "-M=force"
git push -u origin main                                                   ###push your local main branch to remote origin/main branch and set it as default associated remote branch. 
                                                                            "origin:remote repository name"  "main: local main branch" "-u = --set-upstream, bulid up the default link relationship between local branch and remote branch"
#troubleshooting tips:
"""check remote address"""
code:
git remote -v
"""if it is error address, you can change it by following code:"""
git remote set-url origin git@github.com:"correct user name"/"correct repository name".git

"""check which github account your computer have linked to """
ssh -T git@github.com

#check whether it is successfully linking
git remote -v
""" you should see<origin  git@github.com:"user name"/"repository name".git (fetch)
                   origin  git@github.com:"user name"/"repository name".git (push)>""""
